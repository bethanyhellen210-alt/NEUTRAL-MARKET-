# Required for subscriber auth, subscriptions, per-user broker links and trade history
DATABASE_URL=
# Optional only if your managed PostgreSQL requires explicit SSL configuration
DATABASE_SSL=

# MetaApi master token: server-only, grants access to MetaApi accounts created for subscribers
METAAPI_TOKEN=

# Set to a long random value; never expose it to browser code
NEXUSFX_ADMIN_SECRET=
# Configure both with the SAME long random value for Vercel Cron authorization
CRON_SECRET=
NEXUSFX_ENGINE_SECRET=

# Live trading is intentionally disabled until the account, risk and execution setup is validated
LIVE_TRADING_ENABLED=false

# Paystack server-side keys; verify your Paystack account supports USD before taking payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=USD

# Absolute HTTPS origin, e.g. https://your-project.vercel.app
APP_BASE_URL=
